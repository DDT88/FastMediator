<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

	  
	  <!-- Metadati del pacchetto NuGet -->
	  <PackageId>FastMediator</PackageId>
	  <Version>0.0.7</Version>
	  <Authors>Daniele Del Toso</Authors>
	  <Description>Un'implementazione leggera e performante del pattern Mediator per .NET, ottimizzata per prestazioni e facilità d'uso.</Description>
	  <PackageTags>mediator;cqrs;dotnet;performance</PackageTags>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://github.com/DDT88/FastMediator</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/DDT88/FastMediator</RepositoryUrl>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageIcon>icon.png</PackageIcon>
	  <IsPackable>true</IsPackable>
	  <!-- Genera documentazione XML -->
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>


  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="2.1.1" />
    <PackageReference Include="Scrutor" Version="6.0.1" />
	<None Include="..\README.md" Pack="true" PackagePath="\" />
	<None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
